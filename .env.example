# Anthropic API key — required for all agent, judge, and depth evaluation sessions
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>

# Optional: Anthropic Admin API key for organization-level usage/cost reporting
# Get this from Claude Console > Settings > Admin API Keys
# Enables the /api/costs/anthropic endpoint in the monitor dashboard
# ANTHROPIC_ADMIN_KEY=<YOUR_ANTHROPIC_ADMIN_KEY>
